{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nodemanage",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/login", "/api/*", "/sub/*", "/install.sh"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodemanage",
      "database_id": "9f948740-d311-4993-911e-30633a2dddcc",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "AGENT_POLL_SECONDS": "60"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
