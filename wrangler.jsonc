{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nodemanage",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub/*", "/install.sh"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodemanage",
      "database_id": "3287135e-2b4f-4ada-aec1-a63e8d6a017c",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "AGENT_POLL_SECONDS": "60"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
