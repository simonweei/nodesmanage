{
  "name": "nodemanage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run release:check && npm run types && tsc --noEmit",
    "check": "npm run build && npm test && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "release:generate": "node scripts/generate-release-manifest.mjs",
    "release:check": "node scripts/generate-release-manifest.mjs --check",
    "db:local": "wrangler d1 migrations apply nodemanage --local",
    "db:remote": "wrangler d1 migrations apply nodemanage --remote",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "latest",
    "@types/node": "^26.3.0",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
